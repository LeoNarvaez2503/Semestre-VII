    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login Root (Obtener root_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Root token saved\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.access_token).to.not.be.undefined;",
                  "    pm.collectionVariables.set(\"root_token\", jsonData.access_token);",
                  "    if (jsonData.refresh_token) {",
                  "        pm.collectionVariables.set(\"root_refresh_token\", jsonData.refresh_token);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"root\",\n  \"password\": \"rootpassword123\"\n}"
            },
            "url": {
              "raw": "http://localhost:9000/usuario/login",
