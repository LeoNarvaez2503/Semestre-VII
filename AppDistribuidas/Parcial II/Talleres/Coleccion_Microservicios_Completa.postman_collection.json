    {
      "name": "6. Asignacion y Trazabilidad",
      "item": [
        {
          "name": "1. Asignar Vehículo A a Usuario A (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
