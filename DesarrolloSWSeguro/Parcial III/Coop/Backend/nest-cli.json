{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/clientes",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/clientes/tsconfig.app.json"
  },
  "projects": {
    "clientes": {
      "type": "application",
      "root": "apps/clientes",
      "entryFile": "main",
      "sourceRoot": "apps/clientes/src",
      "compilerOptions": {
        "tsConfigPath": "apps/clientes/tsconfig.app.json"
      }
    },
    "cuentas": {
      "type": "application",
      "root": "apps/cuentas",
      "entryFile": "main",
      "sourceRoot": "apps/cuentas/src",
      "compilerOptions": {
        "tsConfigPath": "apps/cuentas/tsconfig.app.json"
      }
    },
    "transacciones": {
      "type": "application",
      "root": "apps/transacciones",
      "entryFile": "main",
      "sourceRoot": "apps/transacciones/src",
      "compilerOptions": {
        "tsConfigPath": "apps/transacciones/tsconfig.app.json"
      }
    }
  }
}
