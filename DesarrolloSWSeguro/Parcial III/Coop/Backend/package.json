{
  "name": "mushuc-runa-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend NestJS + TypeORM para clientes, cuentas y transacciones.",
  "scripts": {
    "build": "nest build clientes && nest build cuentas && nest build transacciones",
    "start:clientes": "nest start clientes",
    "start:cuentas": "nest start cuentas",
    "start:transacciones": "nest start transacciones",
    "start:dev:clientes": "nest start clientes --watch",
    "start:dev:cuentas": "nest start cuentas --watch",
    "start:dev:transacciones": "nest start transacciones --watch",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^3.0.7",
    "ioredis": "^5.11.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.6",
    "@types/http-proxy-middleware": "^0.19.3",
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
